<Project>
  <PropertyGroup>
    <!-- zenoh-c release that scripts/fetch-zenohc.sh downloads and the bindings target. -->
    <ZenohCVersion>1.10.2</ZenohCVersion>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <ZenohNativeDir>$(MSBuildThisFileDirectory)native/</ZenohNativeDir>
    <!-- Portable RID of the build machine (NETCoreSdkRuntimeIdentifier can be distro-specific). -->
    <ZenohHostArch>$([System.Runtime.InteropServices.RuntimeInformation]::OSArchitecture.ToString().ToLowerInvariant())</ZenohHostArch>
    <ZenohHostRid Condition="$([MSBuild]::IsOSPlatform('Linux'))">linux-$(ZenohHostArch)</ZenohHostRid>
    <ZenohHostRid Condition="$([MSBuild]::IsOSPlatform('OSX'))">osx-$(ZenohHostArch)</ZenohHostRid>
    <ZenohHostRid Condition="$([MSBuild]::IsOSPlatform('Windows'))">win-$(ZenohHostArch)</ZenohHostRid>
    <!-- Reproducible builds with normalized source paths on CI (SourceLink maps them to GitHub). -->
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>
</Project>
