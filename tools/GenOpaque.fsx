// Generate F# definitions of the zenoh-c opaque types from zenoh_opaque.h and zenoh_commons.h.
//
// zenoh-c exposes owned/loaned/view types as byte blobs of a fixed size and alignment
// (`typedef struct ALIGN(8) z_owned_session_t { uint8_t _0[8]; } z_owned_session_t;`).
// The sizes depend on the target architecture, so regenerate after fetching the headers
// of another zenoh-c version or target:
//
//   dotnet fsi tools/GenOpaque.fsx [native/include] [src/Zenoh.FSharp/Native/Opaque.g.fs]
open System
open System.IO
open System.Text.RegularExpressions

let args = fsi.CommandLineArgs |> Array.skip 1
let root = Path.GetFullPath(Path.Combine(__SOURCE_DIRECTORY__, ".."))
let includeDir = args |> Array.tryItem 0 |> Option.defaultValue (Path.Combine(root, "native/include"))
let output = args |> Array.tryItem 1 |> Option.defaultValue (Path.Combine(root, "src/Zenoh.FSharp/Native/Opaque.g.fs"))

// Most opaque types are in zenoh_opaque.h; a few (ze_owned_sample_miss_listener_t) are in zenoh_commons.h.
let headers = [ "zenoh_opaque.h"; "zenoh_commons.h" ] |> List.map (fun h -> File.ReadAllText(Path.Combine(includeDir, h)))
let version =
    let v = Path.Combine(includeDir, "zenoh_configure.h")
    if File.Exists v then
        let m = Regex.Match(File.ReadAllText v, "#define ZENOH_C \"([^\"]+)\"")
        if m.Success then m.Groups[1].Value else "unknown"
    else "unknown"

// Types returned by value from zenoh-c: their F# definition must reproduce the C calling
// convention classification, so they are hand-written in Native/Types.fs.
let handWritten = set [ "z_id_t" ]

// One struct per match: alignment, name, body.
let structRx =
    Regex(@"typedef struct ALIGN\((\d+)\) (\w+) \{(.*?)\} \2;", RegexOptions.Singleline)

// Field forms used in zenoh_opaque.h: `uint8_t _0[N];` and `size_t _0;`.
let fieldSize (body: string) =
    Regex.Matches(body, @"^\s*(uint8_t|size_t|uint64_t|uint32_t)\s+\w+(?:\[(\d+)\])?;", RegexOptions.Multiline)
    |> Seq.sumBy (fun m ->
        let elem =
            match m.Groups[1].Value with
            | "uint8_t" -> 1
            | "uint32_t" -> 4
            | _ -> 8 // size_t / uint64_t on 64-bit targets
        let count = if m.Groups[2].Success then int m.Groups[2].Value else 1
        elem * count)

let alignField =
    function
    | 1 -> "byte"
    | 2 -> "uint16"
    | 4 -> "uint32"
    | 8 -> "uint64"
    | a -> failwithf "unsupported alignment %d" a

let types =
    headers
    |> Seq.collect structRx.Matches
    |> Seq.map (fun m -> m.Groups[2].Value, int m.Groups[1].Value, fieldSize m.Groups[3].Value)
    |> Seq.distinctBy (fun (n, _, _) -> n)
    |> Seq.filter (fun (n, _, _) -> not (handWritten.Contains n))
    |> Seq.sortBy (fun (n, _, _) -> n)
    |> Seq.toList

if types.IsEmpty then failwithf "no opaque types found in %s" includeDir

let sb = Text.StringBuilder()
let line (s: string) = sb.AppendLine s |> ignore
line "// <auto-generated>"
line $"// Generated by tools/GenOpaque.fsx from the headers of zenoh-c {version}."
line "// Sizes and alignments are those of the target the headers were generated for (64-bit)."
line "// Do not edit: regenerate instead."
line "// </auto-generated>"
line "namespace Zenoh.Native"
line ""
line "open System.Runtime.InteropServices"
line ""
line "#nowarn \"9\""
line ""
line "/// zenoh-c release the opaque layouts were generated from."
line "module OpaqueLayout ="
line $"    [<Literal>]"
line $"    let ZenohCVersion = \"{version}\""
line ""
for (name, align, size) in types do
    line $"[<Struct; StructLayout(LayoutKind.Sequential, Size = {size})>]"
    line $"type {name} ="
    line $"    val private _align: {alignField align}"
    line ""

File.WriteAllText(output, sb.ToString())
printfn "Wrote %d types to %s (zenoh-c %s)" types.Length output version
